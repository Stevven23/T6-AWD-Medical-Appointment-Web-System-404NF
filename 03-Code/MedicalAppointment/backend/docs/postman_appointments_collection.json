{
  "info": {
    "_postman_id": "8f9b3e2a-appointments-collection",
    "name": "Medical Appointment - Auth + Create Appointment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para autenticar y crear una cita médica. Importa y configura la variable de entorno `baseUrlRoot` antes de usar."
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrlRoot}}/auth/login",
          "host": [
            "{{baseUrlRoot}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guarda el token en la variable de environment 'token' si viene en la respuesta",
              "if (pm.response.code === 200) {",
              "  try {",
              "    const json = pm.response.json();",
              "    if (json.token) {",
              "      pm.environment.set('token', json.token);",
              "      console.log('Token guardado en variable de entorno: token');",
              "    } else {",
              "      console.warn('No se encontró token en la respuesta');",
              "    }",
              "  } catch (e) {",
              "    console.error('Error parseando respuesta JSON', e);",
              "  }",
              "} else {",
              "  console.warn('Login failed with status', pm.response.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Appointments - Create Appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor_id\": \"<doctor-uuid>\",\n  \"scheduled_start\": \"2025-12-10T10:00:00.000Z\",\n  \"reason\": \"Consulta general\",\n  \"duration_minutes\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrlRoot}}/appointments",
          "host": [
            "{{baseUrlRoot}}"
          ],
          "path": [
            "appointments"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Comprueba que exista token antes de enviar la petición",
              "if (!pm.environment.get('token')) {",
              "  console.warn('Variable token no encontrada. Ejecuta el request de Login primero.');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  console.log('Cita creada correctamente');",
              "} else {",
              "  console.warn('Status code:', pm.response.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
