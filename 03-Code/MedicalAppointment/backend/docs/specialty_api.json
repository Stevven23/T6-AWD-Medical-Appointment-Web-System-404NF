{
  "basePath": "/api/specialties",
  "endpoints": [
    {
      "method": "POST",
      "path": "/",
      "handler": "createSpecialty",
      "description": "Crear una nueva especialidad",
      "body": { "name": "string (required)", "description": "string (optional)" },
      "successResponse": { "status": 201, "body": { "id": "uuid", "name": "string", "description": "string|null" } }
    },
    {
      "method": "GET",
      "path": "/stats",
      "handler": "getSpecialtyStats",
      "description": "Obtener estadísticas resumidas de especialidades",
      "query": null,
      "successResponse": {
        "status": 200,
        "body": {
          "total": "number",
          "active": "number",
          "newThisMonth": "number",
          "withDoctors": "number",
          "withoutDoctors": "number",
          "specialtyDetails": [
            { "id": "uuid", "name": "string", "totalDoctors": "number", "activeDoctors": "number" }
          ]
        }
      }
    },
    {
      "method": "GET",
      "path": "/filter",
      "handler": "filterSpecialties",
      "description": "Filtrar especialidades por texto en `name` o `description`",
      "query": { "search": "string (optional)" },
      "successResponse": { "status": 200, "body": [ { "id": "uuid", "name": "string", "description": "string|null" } ] }
    },
    {
      "method": "GET",
      "path": "/active",
      "handler": "getActiveSpecialties",
      "description": "Listado de especialidades activas (en el esquema actual todas son consideradas activas)",
      "successResponse": { "status": 200, "body": [ { "id": "uuid", "name": "string" } ] }
    },
    {
      "method": "GET",
      "path": "/",
      "handler": "getAllSpecialties",
      "description": "Obtener todas las especialidades ordenadas por nombre",
      "successResponse": { "status": 200, "body": [ { "id": "uuid", "name": "string", "description": "string|null" } ] }
    },
    {
      "method": "GET",
      "path": "/:id/doctors",
      "handler": "getSpecialtyWithDoctors",
      "description": "Obtener una especialidad y sus doctores asociados",
      "params": { "id": "uuid" },
      "successResponse": { "status": 200, "body": { "id": "uuid", "name": "string", "doctors": [ { "id": "uuid", "user_id": "uuid", "professional_id": "string", "bio": "string", "active": "boolean" } ], "doctorCount": "number" } }
    },
    {
      "method": "GET",
      "path": "/:id",
      "handler": "getSpecialtyById",
      "description": "Obtener datos de una especialidad por su ID",
      "params": { "id": "uuid" },
      "successResponse": { "status": 200, "body": { "id": "uuid", "name": "string", "description": "string|null" } },
      "notFoundResponse": { "status": 404, "body": { "error": "Especialidad no encontrada" } }
    },
    {
      "method": "PUT",
      "path": "/:id",
      "handler": "updateSpecialty",
      "description": "Actualizar nombre y/o descripción de una especialidad",
      "params": { "id": "uuid" },
      "body": { "name": "string (optional)", "description": "string (optional)" },
      "successResponse": { "status": 200, "body": { "id": "uuid", "name": "string", "description": "string|null" } }
    },
    {
      "method": "DELETE",
      "path": "/:id",
      "handler": "deleteSpecialty",
      "description": "Eliminar una especialidad si no tiene doctores asociados",
      "params": { "id": "uuid" },
      "successResponse": { "status": 200, "body": { "message": "Especialidad eliminada exitosamente", "deleted": { "id": "uuid", "name": "string" } } },
      "conflictResponse": { "status": 400, "body": { "error": "No se puede eliminar la especialidad porque tiene doctores asociados", "doctorsCount": "number" } }
    },
    {
      "method": "PATCH",
      "path": "/:id/status",
      "handler": "updateSpecialtyStatus",
      "description": "Endpoint placeholder: no hay campo `status` en el esquema actual — devuelve la especialidad tal cual",
      "params": { "id": "uuid" },
      "successResponse": { "status": 200, "body": { "id": "uuid", "name": "string", "description": "string|null" } }
    }
  ]
}
